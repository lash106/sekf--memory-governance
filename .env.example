# Copy to .env (git-ignored). Never commit real keys.

# Offline mode uses the deterministic fake roles and needs no key.
SEKF_PROVIDER=fake

# Real OpenAI-compatible provider (SPEC decision D1 / ADR 0002).
# SEKF_PROVIDER=openai
# SEKF_LLM_BASE_URL=https://api.openai.com/v1
# SEKF_LLM_API_KEY=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
# SEKF_LLM_MODEL=gpt-4o-mini
# Optional USD per 1M tokens. Set both, or omit both to use the versioned table in
# sekf.providers.openai_compatible (gpt-4o-mini only; other models record cost 0).
# SEKF_LLM_INPUT_COST_PER_MTOK=0.15
# SEKF_LLM_OUTPUT_COST_PER_MTOK=0.60

# Which implementation each part of the app uses.
# SEKF_MEMORY: sql (default, SQLite at SEKF_DB_URL; decisions change claim state)
#              | memory (test double: records decisions but applies no state transitions)
# SEKF_HISTORIAN: deterministic (default, rule-based, no LLM) | fake
SEKF_MEMORY=sql
SEKF_HISTORIAN=deterministic

# SQLite path for the persistent memory store (used when SEKF_MEMORY=sql).
SEKF_DB_URL=sqlite:///./data/sekf.sqlite3
