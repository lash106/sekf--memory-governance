        "claim_id",
        "claim_text",
        "subject_key",
        "predicate_key",
        "object_text",
        "status",
        "version",
        "confidence",
        "created_at",
        "updated_at"
      ],
      "title": "ExistingClaim",
      "type": "object"
    },
