{
  "$defs": {
    "CandidateClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "format": "uuid",
          "title": "Claim Id",
          "type": "string"
        },
        "claim_text": {
          "minLength": 1,
          "title": "Claim Text",
          "type": "string"
        },
        "extractor_confidence": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Extractor Confidence",
          "type": "number"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "object_text": {
          "minLength": 1,
          "title": "Object Text",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "predicate_key": {
          "minLength": 1,
          "title": "Predicate Key",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "subject_key": {
          "minLength": 1,
          "title": "Subject Key",
          "type": "string"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        }
      },
      "required": [
        "claim_id",
        "claim_text",
        "subject_key",
        "predicate_key",
        "object_text",
        "source_id",
        "observed_at"
      ],
      "title": "CandidateClaim",
      "type": "object"
    },
    "ClaimStatus": {
      "enum": [
        "CANDIDATE",
        "ACTIVE",
        "QUARANTINED",
        "SUPERSEDED",
        "REJECTED"
      ],
      "title": "ClaimStatus",
      "type": "string"
    },
    "ConflictType": {
      "enum": [
        "NONE",
        "DUPLICATE",
        "PARAPHRASE",
        "VALUE_CONFLICT",
        "TEMPORAL_UPDATE",
        "SOURCE_CONFLICT",
        "UNKNOWN"
      ],
      "title": "ConflictType",
      "type": "string"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "content_hash": {
          "default": "",
          "title": "Content Hash",
          "type": "string"
        },
        "evidence_id": {
          "format": "uuid",
          "title": "Evidence Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "reliability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Reliability",
          "type": "number"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_type": {
          "title": "Source Type",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "content",
        "source_id",
        "source_type",
        "retrieved_at",
        "reliability"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "ExistingClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "format": "uuid",
          "title": "Claim Id",
          "type": "string"
        },
        "claim_text": {
          "title": "Claim Text",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "object_text": {
          "title": "Object Text",
          "type": "string"
        },
        "predicate_key": {
          "title": "Predicate Key",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ClaimStatus"
        },
        "subject_key": {
          "title": "Subject Key",
          "type": "string"
        },
        "supersedes_claim_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Claim Id"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "claim_id",
        "claim_text",
        "subject_key",
        "predicate_key",
        "object_text",
        "status",
        "version",
        "confidence",
        "created_at",
        "updated_at"
      ],
      "title": "ExistingClaim",
      "type": "object"
    },
    "FinalAction": {
      "enum": [
        "PROMOTE",
        "ATTACH_EVIDENCE",
        "KEEP_EPISODIC",
        "QUARANTINE",
        "REVISE",
        "REJECT",
        "ESCALATE_FOR_REVIEW"
      ],
      "title": "FinalAction",
      "type": "string"
    },
    "HistorianAssessment": {
      "additionalProperties": false,
      "properties": {
        "assessment_id": {
          "format": "uuid",
          "title": "Assessment Id",
          "type": "string"
        },
        "candidate_claim_id": {
          "format": "uuid",
          "title": "Candidate Claim Id",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "conflict_type": {
          "$ref": "#/$defs/ConflictType"
        },
        "estimated_cost_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Estimated Cost Usd",
          "type": "number"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "llm_calls": {
          "minimum": 0,
          "title": "Llm Calls",
          "type": "integer"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "prompt_hash": {
          "minLength": 1,
          "title": "Prompt Hash",
          "type": "string"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "string"
        },
        "provenance_quality": {
          "$ref": "#/$defs/ProvenanceQuality"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "related_claim_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Related Claim Ids",
          "type": "array"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "source_reliability_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Source Reliability Score",
          "type": "number"
        },
        "supersedes_claim_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Claim Id"
        },
        "temperature": {
          "minimum": 0.0,
          "title": "Temperature",
          "type": "number"
        },
        "temporal_relation": {
          "$ref": "#/$defs/TemporalRelation"
        }
      },
      "required": [
        "model",
        "prompt_version",
        "provider",
        "temperature",
        "prompt_hash",
        "llm_calls",
        "assessment_id",
        "candidate_claim_id",
        "provenance_quality",
        "temporal_relation",
        "conflict_type",
        "source_reliability_score",
        "confidence",
        "rationale"
      ],
      "title": "HistorianAssessment",
      "type": "object"
    },
    "JudgeAssessment": {
      "additionalProperties": false,
      "properties": {
        "assessment_id": {
          "format": "uuid",
          "title": "Assessment Id",
