    "RoleFailure": {
      "additionalProperties": false,
      "description": "A typed role failure (timeout, invalid output, provider down).\n\nToken and call totals cover attempts that failed validation, so a repaired-then-rejected\nrole is not recorded as free. Defaults stay zero for failures that never reached a model.",
      "properties": {
        "error_type": {
          "title": "Error Type",
          "type": "string"
        },
        "estimated_cost_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Estimated Cost Usd",
          "type": "number"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "llm_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Llm Calls",
          "type": "integer"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "output_tokens": {
