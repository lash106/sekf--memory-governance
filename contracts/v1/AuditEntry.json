{
  "$defs": {
    "CandidateClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "format": "uuid",
          "title": "Claim Id",
          "type": "string"
        },
        "claim_text": {
          "minLength": 1,
          "title": "Claim Text",
          "type": "string"
        },
        "extractor_confidence": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Extractor Confidence",
          "type": "number"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "object_text": {
          "minLength": 1,
          "title": "Object Text",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "predicate_key": {
          "minLength": 1,
          "title": "Predicate Key",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "subject_key": {
          "minLength": 1,
          "title": "Subject Key",
          "type": "string"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        }
      },
      "required": [
        "claim_id",
        "claim_text",
        "subject_key",
        "predicate_key",
        "object_text",
        "source_id",
        "observed_at"
      ],
      "title": "CandidateClaim",
      "type": "object"
    },
    "ClaimStatus": {
      "enum": [
        "CANDIDATE",
        "ACTIVE",
        "QUARANTINED",
        "SUPERSEDED",
        "REJECTED"
      ],
      "title": "ClaimStatus",
      "type": "string"
    },
    "CommitBundle": {
      "additionalProperties": false,
      "description": "Everything persisted for one decision, written atomically by `apply_decision`.\n\nNothing is written to memory before the policy has decided; a commit stores the raw\ninputs, the role outputs, and the decision together, or not at all.",
      "properties": {
        "candidate": {
          "$ref": "#/$defs/CandidateClaim"
        },
        "decision": {
          "$ref": "#/$defs/DecisionRecord"
        },
        "episode": {
          "anyOf": [
            {
              "$ref": "#/$defs/EpisodeRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRecord"
          },
          "title": "Evidence",
          "type": "array"
        },
        "historian": {
          "anyOf": [
            {
              "$ref": "#/$defs/HistorianAssessment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "idempotency_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        },
        "judge": {
          "anyOf": [
            {
              "$ref": "#/$defs/JudgeAssessment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "memory_before": {
          "items": {
            "$ref": "#/$defs/ExistingClaim"
          },
          "title": "Memory Before",
          "type": "array"
        },
        "role_errors": {
          "items": {
            "$ref": "#/$defs/RoleFailure"
          },
          "title": "Role Errors",
          "type": "array"
        },
        "run_config": {
          "$ref": "#/$defs/RunConfig"
        },
        "synthesizer": {
          "anyOf": [
            {
              "$ref": "#/$defs/SynthesizerRecommendation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "candidate",
        "decision"
      ],
      "title": "CommitBundle",
      "type": "object"
    },
    "ConflictType": {
      "enum": [
        "NONE",
        "DUPLICATE",
        "PARAPHRASE",
        "VALUE_CONFLICT",
        "TEMPORAL_UPDATE",
        "SOURCE_CONFLICT",
        "UNKNOWN"
      ],
      "title": "ConflictType",
      "type": "string"
    },
    "CostSummary": {
      "additionalProperties": false,
      "properties": {
        "estimated_cost_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Estimated Cost Usd",
          "type": "number"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "llm_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Llm Calls",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "title": "CostSummary",
      "type": "object"
    },
    "DecisionRecord": {
      "additionalProperties": false,
      "properties": {
        "candidate_claim_id": {
          "format": "uuid",
          "title": "Candidate Claim Id",
          "type": "string"
        },
        "cost": {
          "$ref": "#/$defs/CostSummary"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "decision_id": {
          "format": "uuid",
          "title": "Decision Id",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "final_action": {
          "$ref": "#/$defs/FinalAction"
        },
        "historian_assessment_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Historian Assessment Id"
        },
        "judge_assessment_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Judge Assessment Id"
        },
        "policy_version": {
          "title": "Policy Version",
          "type": "string"
        },
        "previous_claim_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Previous Claim Ids",
          "type": "array"
        },
        "request_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Request Hash",
          "type": "string"
        },
        "resulting_claim_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resulting Claim Id"
        },
        "rule_action": {
          "$ref": "#/$defs/FinalAction"
        },
        "rule_ids_fired": {
          "items": {
            "type": "string"
          },
          "title": "Rule Ids Fired",
          "type": "array"
        },
        "synthesizer_recommendation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Synthesizer Recommendation Id"
        },
        "thresholds": {
          "$ref": "#/$defs/Thresholds"
        }
      },
      "required": [
        "decision_id",
        "candidate_claim_id",
        "final_action",
        "rule_action",
        "policy_version",
        "request_hash",
        "thresholds",
        "rule_ids_fired",
        "explanation",
        "created_at"
      ],
      "title": "DecisionRecord",
      "type": "object"
    },
    "EpisodeRecord": {
      "additionalProperties": false,
      "description": "Raw experience, preserved before any claim extraction.",
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "episode_id": {
          "format": "uuid",
          "title": "Episode Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        }
