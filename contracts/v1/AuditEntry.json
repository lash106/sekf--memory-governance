        "source_type": {
          "title": "Source Type",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "content",
        "source_id",
        "source_type",
        "retrieved_at",
        "reliability"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "ExistingClaim": {
      "additionalProperties": false,
