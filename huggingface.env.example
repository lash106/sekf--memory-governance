# Copy this file to huggingface.env (git-ignored) and paste a Hugging Face token.
# Do not put a token in this example file. Do not commit huggingface.env.
#
# Token: https://huggingface.co/settings/tokens  (read / inference permission)
# The existing OpenAI-compatible provider talks to Hugging Face's router.
# That is allowed by ADR 0002: any OpenAI-compatible base URL.

SEKF_PROVIDER=openai
SEKF_LLM_BASE_URL=https://router.huggingface.co/v1
SEKF_LLM_API_KEY=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
SEKF_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# If that model is gated or JSON mode fails, try one of these instead:
# SEKF_LLM_MODEL=HuggingFaceTB/SmolLM3-3B
# SEKF_LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# SEKF_LLM_MODEL=meta-llama/Llama-3.2-3B-Instruct
#
# Then run:
#   python experiments/run_dev_pilot.py
