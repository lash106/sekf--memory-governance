        },
        "candidate_claim_id": {
          "format": "uuid",
          "title": "Candidate Claim Id",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "estimated_cost_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Estimated Cost Usd",
          "type": "number"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "label": {
          "$ref": "#/$defs/JudgeLabel"
        },
        "latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "llm_calls": {
          "minimum": 0,
          "title": "Llm Calls",
          "type": "integer"
        },
        "missing_information": {
          "items": {
            "type": "string"
          },
          "title": "Missing Information",
          "type": "array"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "prompt_hash": {
          "minLength": 1,
          "title": "Prompt Hash",
          "type": "string"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "refuting_evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Refuting Evidence Ids",
          "type": "array"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "supporting_evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Supporting Evidence Ids",
          "type": "array"
        },
        "temperature": {
          "minimum": 0.0,
          "title": "Temperature",
          "type": "number"
        }
      },
      "required": [
        "model",
        "prompt_version",
        "provider",
        "temperature",
        "prompt_hash",
        "llm_calls",
        "assessment_id",
        "candidate_claim_id",
        "label",
        "confidence",
        "rationale"
      ],
      "title": "JudgeAssessment",
      "type": "object"
    },
    "JudgeLabel": {
      "enum": [
        "SUPPORTED",
        "REFUTED",
        "INSUFFICIENT_EVIDENCE",
        "MIXED_EVIDENCE",
        "INVALID_INPUT"
      ],
      "title": "JudgeLabel",
      "type": "string"
    },
    "ProvenanceQuality": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
      ],
      "title": "ProvenanceQuality",
      "type": "string"
    },
    "RoleFailure": {
      "additionalProperties": false,
      "description": "A typed role failure (timeout, invalid output, provider down).\n\nToken and call totals cover attempts that failed validation, so a repaired-then-rejected\nrole is not recorded as free. Defaults stay zero for failures that never reached a model.",
      "properties": {
        "error_type": {
          "title": "Error Type",
          "type": "string"
        },
        "estimated_cost_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Estimated Cost Usd",
          "type": "number"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "llm_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Llm Calls",
          "type": "integer"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "role": {
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "error_type",
        "message"
      ],
      "title": "RoleFailure",
      "type": "object"
    },
    "RunConfig": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "default": "fake/none",
          "title": "Model",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "temperature": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Temperature",
          "type": "number"
        },
        "timeout_s": {
          "default": 30.0,
          "exclusiveMinimum": 0.0,
          "title": "Timeout S",
          "type": "number"
        }
      },
      "title": "RunConfig",
      "type": "object"
    },
    "SynthesizerRecommendation": {
      "additionalProperties": false,
      "description": "Advisory only: it may make an outcome more conservative, never less.",
      "properties": {
        "candidate_claim_id": {
          "format": "uuid",
          "title": "Candidate Claim Id",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "estimated_cost_usd": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Estimated Cost Usd",
          "type": "number"
        },
        "historian_assessment_id": {
          "format": "uuid",
          "title": "Historian Assessment Id",
          "type": "string"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "judge_assessment_id": {
          "format": "uuid",
          "title": "Judge Assessment Id",
          "type": "string"
        },
        "latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "llm_calls": {
          "minimum": 0,
          "title": "Llm Calls",
          "type": "integer"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "prompt_hash": {
          "minLength": 1,
          "title": "Prompt Hash",
          "type": "string"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "recommendation_id": {
          "format": "uuid",
          "title": "Recommendation Id",
          "type": "string"
        },
        "recommended_action": {
          "$ref": "#/$defs/FinalAction"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "temperature": {
          "minimum": 0.0,
          "title": "Temperature",
          "type": "number"
        },
        "unresolved_questions": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Questions",
          "type": "array"
        }
      },
      "required": [
        "model",
        "prompt_version",
        "provider",
        "temperature",
        "prompt_hash",
        "llm_calls",
        "recommendation_id",
        "candidate_claim_id",
        "recommended_action",
        "confidence",
        "historian_assessment_id",
        "judge_assessment_id",
        "rationale"
      ],
      "title": "SynthesizerRecommendation",
      "type": "object"
    },
    "TemporalRelation": {
      "enum": [
        "NO_RELATED_CLAIM",
        "SAME_PERIOD",
        "OLDER_INFORMATION",
        "NEWER_UPDATE",
        "OVERLAPPING_VALIDITY",
        "NON_OVERLAPPING_VALIDITY",
        "UNKNOWN"
      ],
      "title": "TemporalRelation",
      "type": "string"
    },
    "Thresholds": {
      "additionalProperties": false,
      "properties": {
        "historian_confidence_threshold": {
          "default": 0.7,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Historian Confidence Threshold",
          "type": "number"
        },
        "refute_threshold": {
          "default": 0.8,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Refute Threshold",
          "type": "number"
        },
        "source_reliability_threshold": {
          "default": 0.6,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Source Reliability Threshold",
          "type": "number"
        },
        "support_threshold": {
          "default": 0.8,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Support Threshold",
          "type": "number"
        },
        "synthesizer_veto_threshold": {
          "default": 0.8,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Synthesizer Veto Threshold",
          "type": "number"
        }
      },
      "title": "Thresholds",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "$ref": "#/$defs/CandidateClaim"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRecord"
      },
      "title": "Evidence",
      "type": "array"
    },
    "historian": {
      "anyOf": [
        {
          "$ref": "#/$defs/HistorianAssessment"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "idempotency_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "judge": {
      "anyOf": [
        {
          "$ref": "#/$defs/JudgeAssessment"
        },
        {
          "type": "null"
        }
      ],
      "default": null
