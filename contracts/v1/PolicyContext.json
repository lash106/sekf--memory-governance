    "now": {
      "format": "date-time",
      "title": "Now",
      "type": "string"
    },
    "related_claims": {
      "items": {
        "$ref": "#/$defs/ExistingClaim"
      },
      "title": "Related Claims",
      "type": "array"
    },
    "role_errors": {
      "items": {
        "$ref": "#/$defs/RoleFailure"
      },
      "title": "Role Errors",
      "type": "array"
    },
    "run_config": {
      "$ref": "#/$defs/RunConfig"
    },
    "synthesizer": {
      "anyOf": [
        {
          "$ref": "#/$defs/SynthesizerRecommendation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "thresholds": {
      "$ref": "#/$defs/Thresholds"
    }
  },
  "required": [
    "candidate",
    "now"
  ],
  "title": "PolicyContext",
  "type": "object"
}
